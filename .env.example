# Copy this file to `.env` and add your OpenAI API key.

OPENAI_API_KEY=sk-...

# Optional overrides (sensible defaults shown):
# LLM_MODEL=gpt-4o-mini          # text model for extraction + generation
# OCR_MODEL=gpt-4o-mini          # vision model that reads the statement image
# LLM_BASE_URL=https://api.openai.com/v1   # e.g. an Azure/OpenAI-compatible endpoint

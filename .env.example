# Copy this file to `.env`.
#
# By default the pipeline talks to a LOCAL Ollama server (OpenAI-compatible API), so
# development and testing do not consume hosted API credits. Make sure Ollama is running
# and the model below is pulled (`ollama pull qwen3:8b`).

# --- Local Ollama (default) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# --- To use hosted OpenAI instead, set these (and a real key): ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
